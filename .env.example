# Copy this file to .env and fill in the keys. .env is git-ignored; never commit it.
#
# The pipeline talks to any provider with an OpenAI-compatible chat API, so switching
# provider means changing these values, not the code. Everything here works on a free tier.

# --- Primary model -----------------------------------------------------------------------
# Mistral free tier: https://admin.mistral.ai  ->  API Keys
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_API_KEY=
LLM_MODEL=mistral-large-2512

# The provider's published limits for that model, set slightly below them for headroom.
# mistral-large-2512 free tier: 1 request/second, 250,000 tokens/minute.
LLM_REQUESTS_PER_MINUTE=55
LLM_TOKENS_PER_MINUTE=200000
# Smallest gap between two calls, in ms. Needed when the limit is per second, not per minute.
LLM_MIN_GAP_MS=1100

# --- Fallback model (optional) -----------------------------------------------------------
# Used when the primary is still rate-limited or failing after its retries. A different
# provider is best, so one provider's outage cannot stop a run. Leave the key empty to
# run without a fallback.
# Gemini free tier: https://aistudio.google.com  ->  Get API key
LLM_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_FALLBACK_API_KEY=
# The exact model id as AI Studio shows it, e.g. the Flash Lite model with the 500/day limit.
LLM_FALLBACK_MODEL=
LLM_FALLBACK_REQUESTS_PER_MINUTE=12
LLM_FALLBACK_TOKENS_PER_MINUTE=200000
LLM_FALLBACK_MIN_GAP_MS=
