# Copy this file to .env and fill in the keys. .env is git-ignored; never commit it.

# Required. Google AI Studio free tier: https://aistudio.google.com  ->  Get API key
# Runs gemini-3.5-flash-lite, and gemini-3.1-flash-lite when that one is rate-limited.
GEMINI_API_KEY=

# Optional. Groq free tier: https://console.groq.com  ->  API Keys
# Runs qwen/qwen3.8-27b as the last resort. Leave empty to run without it.
GROQ_API_KEY=

# --- The web application's API (not needed for `npm run evaluate`) ------------------------

# Required by the API. MongoDB Atlas free tier (M0): https://cloud.mongodb.com  ->  Connect
# Replace BOTH placeholders in the string Atlas gives you, <db_username> and <db_password>.
# A database name before the "?" is optional; the API uses "prepkit" when there is none.
MONGODB_URI=

# Optional. The address the web app is opened at. State-changing requests from any other
# website are refused. Defaults to http://localhost:3000; set it to the deployed URL in production.
WEB_ORIGIN=
