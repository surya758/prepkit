# Copy this file to .env and fill in the keys. .env is git-ignored; never commit it.
#
# The pipeline talks to any provider with an OpenAI-compatible chat API, so switching
# provider means changing these values, not the code. Everything here works on a free tier.
#
# Models are tried in order: 1 -> 2 -> 3. A model that keeps failing is skipped for a
# while and the next one takes over. Only model 1 is required; a model with no model id
# or no usable key is left out of the chain.

# --- 1. Primary model (required) ---------------------------------------------------------
# Gemini free tier: https://aistudio.google.com  ->  Get API key
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite

# The provider's published limits for that model, set slightly below them for headroom.
# Free tier at the time of writing: 15 requests/minute, 250,000 tokens/minute, 500 requests/day.
# Check yours at https://aistudio.google.com/rate-limit
LLM_REQUESTS_PER_MINUTE=12
LLM_TOKENS_PER_MINUTE=200000
# Smallest gap between two calls, in ms. Only needed when a provider limits per second
# (e.g. "1 request per second" -> 1100). Leave empty otherwise.
LLM_MIN_GAP_MS=

# --- 2. Second model: same provider, separate quota (optional) ---------------------------
# Takes over when model 1 is rate-limited. Gemini counts quota per model, so a second
# Flash Lite model on the same key has its own allowance. This is still Google, so the
# base URL is the same; the key defaults to LLM_API_KEY when left empty.
LLM_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=gemini-3.1-flash-lite
LLM_FALLBACK_REQUESTS_PER_MINUTE=12
LLM_FALLBACK_TOKENS_PER_MINUTE=200000
LLM_FALLBACK_MIN_GAP_MS=

# --- 3. Third model: a different provider (optional) -------------------------------------
# Takes over when the provider above is itself the problem (an outage, a revoked key).
# Groq free tier: https://console.groq.com  ->  API Keys
# Free tier at the time of writing: 30 requests/minute, 8,000 tokens/minute, 1,000 requests/day.
# Tokens per minute is the tight one here. Check yours under Settings -> Limits.
# Leave LLM_FALLBACK_2_API_KEY empty to run without it.
LLM_FALLBACK_2_BASE_URL=https://api.groq.com/openai/v1
LLM_FALLBACK_2_API_KEY=
LLM_FALLBACK_2_MODEL=qwen/qwen3.8-27b
LLM_FALLBACK_2_REQUESTS_PER_MINUTE=25
LLM_FALLBACK_2_TOKENS_PER_MINUTE=6000
LLM_FALLBACK_2_MIN_GAP_MS=
