# Copy this file to .env and fill in the keys. .env is git-ignored; never commit it.
#
# Only secrets live here. Which models are used, in what order, and their rate limits are
# in packages/core/src/llm/models.ts. Everything works on a free tier.

# Required. Google AI Studio free tier: https://aistudio.google.com  ->  Get API key
# Runs gemini-3.5-flash-lite, and gemini-3.1-flash-lite when that one is rate-limited.
GEMINI_API_KEY=

# Optional. Groq free tier: https://console.groq.com  ->  API Keys
# Adds a model from a different provider as the last resort. Leave empty to run without it.
GROQ_API_KEY=
