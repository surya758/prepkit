# Copy to .env (git-ignored). Details: README -> Setup.

# Required. https://aistudio.google.com -> Get API key
GEMINI_API_KEY=

# Optional backup model. https://console.groq.com -> API Keys
GROQ_API_KEY=

# --- Only for the web application's API; `npm run evaluate` does not need these ---

# Required. Atlas connection string; replace BOTH <db_username> and <db_password>.
MONGODB_URI=

# Optional. Where the web app is opened. Defaults to http://localhost:3000.
WEB_ORIGIN=
