{
  "name": "interview-prep-kit",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "evaluate": "tsx packages/core/src/cli/evaluate.ts",
